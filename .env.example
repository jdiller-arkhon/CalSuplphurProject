# ── Required ──
# PostgreSQL connection. In production use a managed database with SSL (append ?sslmode=require).
DATABASE_URL="postgresql://csc:CHANGE_ME@localhost:5432/csc"

# Directory for uploaded documents. Must be on a persistent, backed-up disk in production.
FILE_STORAGE_DIR="./storage"

# ── Production only ──
# One-time token required to create the first owner account at /first-run (production builds only).
# Remove it after the owner account exists.
SETUP_TOKEN=""

# ── Development only ──
# Enables the [Sample] data script (npm run db:dev-sample). Never set in production.
APP_ENV="development"

# Test database used by `npm test` (defaults to postgresql://csc:csc_dev@localhost:5432/csc_test).
# TEST_DATABASE_URL=""

